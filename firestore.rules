rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    function isValidUserProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) 
        && isValidUserProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'age', 'gender', 'height', 'weight', 'bloodGroup', 
          'emergencyContact', 'medicalConditions', 'allergies', 'currentMedications', 
          'lifestyle', 'avatarUrl'
        ]);
      allow delete: if false;

      // App Settings Preferences Rules
      function isValidAppSettings(data) {
        return data.theme is string && (data.theme == 'light' || data.theme == 'dark')
          && data.language is string
          && (data.emailNotifications == null || data.emailNotifications is bool)
          && (data.smsNotifications == null || data.smsNotifications is bool)
          && (data.weeklyReports == null || data.weeklyReports is bool)
          && (data.privacyMode == null || data.privacyMode is bool);
      }

      match /settings/preferences {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAppSettings(request.resource.data);
        allow update: if isOwner(userId) 
          && isValidAppSettings(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'theme', 'language', 'emailNotifications', 'smsNotifications', 
            'weeklyReports', 'privacyMode'
          ]);
        allow delete: if false;
      }

      // Health Reports Rules
      function isValidHealthReport(data) {
        return data.id is string && data.id.size() > 0
          && data.fileName is string && data.fileName.size() > 0
          && data.status is string
          && data.userId == userId;
      }

      match /reports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHealthReport(request.resource.data);
        allow update: if isOwner(userId) 
          && isValidHealthReport(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id', 'fileName', 'fileSize', 'uploadDate', 'status', 'errorMessage', 'analysis', 'userId'
          ]);
        allow delete: if isOwner(userId);
      }
    }
  }
}
